{
  "name": "pim-orbit",
  "productName": "Орбита",
  "version": "1.8.8",
  "description": "Локальная статистика по офферам и вебмастерам",
  "author": "ilayskol",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "test": "node --test policy.test.cjs history.test.cjs settings.test.cjs",
    "dist:mac": "electron-builder --mac dmg zip --publish never"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.pim.orbit",
    "productName": "Орбита",
    "executableName": "PIMOrbit",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "policy.cjs",
      "assets/index.html",
      "assets/PIMOrbit-OrbitalKnot.ico",
      "assets/PIMOrbit-OrbitalKnot.png",
      "assets/Лицензии.txt",
      "assets/Инструкция.txt",
      "history.cjs",
      "preload.cjs",
      "settings.cjs",
      "assets/Инструкция-mac.txt"
    ],
    "afterPack": "./harden.cjs",
    "publish": null,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "icon": "assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": false,
      "artifactName": "Orbita-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Орбита",
      "background": "assets/dmg-background.png",
      "window": {
        "width": 620,
        "height": 400
      },
      "iconSize": 92,
      "contents": [
        {
          "x": 165,
          "y": 222,
          "type": "file"
        },
        {
          "x": 455,
          "y": 222,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
